<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}ISDS Thematic Watcher{% endblock %}</title>
  <meta name="description" content="{% block description %}An automated thematic monitor for investor–State dispute settlement developments at the IP-as-investment / judicial-measure / jurisdictional-admissibility intersection.{% endblock %}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Libre+Franklin:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ root }}assets/style.css">
  {% block head_extra %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-nav">
    <div class="nav-inner">
      <a class="brand" href="{{ root }}index.html">
        <span class="brand-mark">ISDS</span>
        <span class="brand-name">Thematic Watcher</span>
      </a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
      <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </label>
      <nav class="nav-links" aria-label="Primary">
        <a href="{{ root }}index.html" class="{{ 'active' if active == 'home' }}">Home</a>
        <a href="{{ root }}methodology.html" class="{{ 'active' if active == 'methodology' }}">Methodology</a>
        <a href="{{ root }}digests/index.html" class="{{ 'active' if active == 'digests' }}">Digest Archive</a>
        <a href="{{ repo_url }}" class="nav-ext" target="_blank" rel="noopener">GitHub&nbsp;&#8599;</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-title">ISDS Thematic Watcher</div>
      <p class="footer-note">Built for the Benavides ISDS research project.</p>
      <nav class="footer-links" aria-label="Footer">
        <a href="{{ root }}methodology.html">Methodology</a>
        <span class="dot">·</span>
        <a href="{{ root }}digests/index.html">Digest Archive</a>
        <span class="dot">·</span>
        <a href="{{ repo_url }}" target="_blank" rel="noopener">GitHub repository &#8599;</a>
      </nav>
      <p class="footer-fine">A zero-cost, open-sources research instrument. Sources read at headline level
        where access is restricted; the Robots Exclusion Protocol is honored, never evaded.</p>
    </div>
  </footer>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ISDS Research Brief #{{ seq }} — {{ date_str }}</title>
<style>
  body { margin:0; padding:0; background:#eceef1;
         font-family: Georgia, 'Times New Roman', serif; color:#1b252e; line-height:1.6; }
  .sheet { max-width:680px; margin:0 auto; background:#ffffff; }
  .util { padding:9px 36px; background:#5a2d3a; }
  .util a { color:#fff; font-family:Arial,Helvetica,sans-serif; font-size:11.5px;
         text-decoration:none; letter-spacing:.03em; }
  .util a:hover { text-decoration:underline; }
  .util .sep { color:#a87f8b; padding:0 8px; }
  .mast { padding:24px 36px 16px; border-bottom:3px double #5a2d3a; }
  .mast .kicker { font-family:Arial,Helvetica,sans-serif; font-size:11px; letter-spacing:.22em;
         text-transform:uppercase; color:#9a7b2e; margin:0 0 4px; }
  .mast h1 { margin:0; font-size:26px; letter-spacing:.3px; color:#5a2d3a; }
  .mast .issue { font-family:Arial,Helvetica,sans-serif; font-size:12px; color:#5a6672; margin-top:6px; }
  .mast .headline { font-size:17px; color:#26303a; margin:12px 0 0; font-weight:bold; line-height:1.4; }
  .dek { padding:16px 36px 4px; font-size:15px; color:#33414f; font-style:italic; }
  .secttl { font-family:Arial,Helvetica,sans-serif; font-size:11px; font-weight:700;
         text-transform:uppercase; letter-spacing:.12em; color:#5a2d3a; padding:22px 36px 0; }
  .secttl .rule { display:block; border-bottom:1px solid #d6dbe1; margin-top:6px; }
  .sect { padding:14px 36px; border-bottom:1px solid #eef0f3; }
  .sect h3 { font-size:16px; color:#26303a; margin:0 0 6px; }
  .sect p { font-size:14.5px; margin:0 0 10px; }
  .supp { padding:12px 36px; border-bottom:1px solid #eef0f3; }
  .supp .t { font-size:15px; margin:0 0 4px; }
  .supp .t a { color:#0b5cae; text-decoration:none; }
  .supp .note { font-size:13.5px; color:#3a4651; margin:0 0 5px; }
  .supp .u { font-family:Arial,Helvetica,sans-serif; font-size:11.5px; }
  .supp .u a { color:#0b5cae; word-break:break-all; text-decoration:none; }
  .threads { padding:10px 36px 18px; }
  .threads li { font-size:14px; margin:6px 0; }
  .empty { padding:10px 36px; color:#6a7280; font-size:13.5px; font-style:italic; }
  .foot { background:#3a1f28; color:#e6d6db; padding:22px 36px 26px;
         font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:1.6; }
  .foot a { color:#e0b3c0; text-decoration:none; }
  .foot .fine { color:#b59aa3; margin-top:12px; font-size:11px; }
</style>
</head>
<body>
<div class="sheet">

  <div class="util">
    {% if site_url %}<a href="{{ site_url }}">View on the web</a><span class="sep">·</span>{% endif %}
    <a href="{{ repo_url }}/blob/main/METHODOLOGY.md">Methodology</a>
  </div>

  <div class="mast">
    <p class="kicker">Interpretive Research · Investor–State Dispute Settlement</p>
    <h1>ISDS Research Brief</h1>
    <p class="issue">Issue #{{ seq }} &nbsp;·&nbsp; {{ generated_at.strftime("%A, %d %B %Y") }}</p>
    <p class="headline">{{ brief.headline }}</p>
  </div>

  <div class="dek">{{ brief.dek }}</div>

  {% for s in brief.sections %}
  <div class="sect">
    <h3>{{ s.heading }}</h3>
    {% for para in s.body.split("\n") %}{% if para.strip() %}<p>{{ para.strip() }}</p>{% endif %}{% endfor %}
  </div>
  {% endfor %}

  <p class="secttl">Supplemental research <span class="rule"></span></p>
  {% if brief.supplemental %}
    {% for r in brief.supplemental %}
    <div class="supp">
      <p class="t"><a href="{{ r.url }}">{{ r.title }}</a></p>
      <p class="note">{{ r.note }}</p>
      <p class="u"><a href="{{ r.url }}">{{ r.url }}</a></p>
    </div>
    {% endfor %}
  {% else %}
    <div class="empty">No supplemental sources were drawn on for this issue.</div>
  {% endif %}

  {% if brief.open_threads %}
  <p class="secttl">Open threads — carried to the next issue <span class="rule"></span></p>
  <ul class="threads">
    {% for t in brief.open_threads %}<li>{{ t }}</li>{% endfor %}
  </ul>
  {% endif %}

  <div class="foot">
    A standing interpretive companion to the ISDS Thematic Watch, produced for the
    Benavides ISDS research project. Each issue reads the week's developments against
    the project's research question and advances open threads from issue to issue.
    <a href="{{ repo_url }}/blob/main/METHODOLOGY.md">Methodology</a>.
    <p class="fine">Interpretations and web-sourced findings are research leads to be
       verified before they are relied upon, not adjudications.</p>
  </div>

</div>
</body>
</html>

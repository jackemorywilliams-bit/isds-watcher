{% extends "base.html.j2" %}
{% block title %}{{ digest.title }} | ISDS Thematic Watcher{% endblock %}
{% block description %}Annotated digest of investor–State dispute developments surfaced on {{ digest.date }}, each with its source, a direct link to the original, a relevance score, and a quoted notable line.{% endblock %}

{% block content %}
<section class="page-head">
  <div class="measure">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ root }}index.html">Home</a></li>
        <li><a href="index.html">Digest Archive</a></li>
        <li aria-current="page">{{ digest.date }}</li>
      </ol>
    </nav>
    <h1 class="page-title">ISDS Thematic Watch</h1>
    <p class="page-date">{{ digest.date }}</p>
    <p class="page-lede">
      An annotated digest of investor–State dispute developments at the IP-as-investment /
      judicial-or-regulatory-measure / jurisdictional-admissibility intersection.
    </p>
    <p class="run-counts"><span class="count">{{ digest.screened_str }}</span> candidate{{ '' if digest.screened == 1 else 's' }} screened
      <span class="sep">·</span>
      <span class="count">{{ digest.matches_str }}</span> match{{ '' if digest.matches == 1 else 'es' }}
      <span class="sep">·</span>
      <span class="count">{{ digest.accepted_str }}</span> item{{ '' if digest.accepted == 1 else 's' }} surfaced</p>
    <div class="run-summary">
      <div class="run-stat"><span class="run-num">{{ digest.screened_str }}</span><span class="run-label">candidates screened</span></div>
      <div class="run-stat"><span class="run-num">{{ digest.matches_str }}</span><span class="run-label">matches</span></div>
      <div class="run-stat"><span class="run-num">{{ digest.accepted_str }}</span><span class="run-label">items surfaced</span></div>
      {% if digest.threshold %}<div class="run-stat"><span class="run-num">{{ digest.threshold }}</span><span class="run-label">relevance threshold</span></div>{% endif %}
      {% if digest.sources %}<div class="run-stat"><span class="run-num run-text">{{ digest.sources }}</span><span class="run-label">source{{ 's' if ',' in digest.sources else '' }}</span></div>{% endif %}
    </div>
    <p class="run-note">
      Entries are ordered by thematic relevance. Each carries a short annotation. A quoted
      notable line appears only where the source text was reachable; an entry marked
      <span class="badge badge-headline">HEADLINE ONLY</span> came from a paywalled feed, carries
      no quotation, and was assessed from its headline alone. Items below the gate are surfaced
      as watch-list leads, not matches. Nothing on this page has been checked by a human against
      its original source.
    </p>
  </div>
</section>

<section class="band">
  <div class="measure">
    <h2 class="section-head">Annotated bibliography: {{ digest.surfaced }} {{ 'entry' if digest.surfaced == 1 else 'entries' }}</h2>

    {% macro entry(e) %}
      <li class="entry reveal" id="entry-{{ e.number }}">
        <div class="entry-top">
          <span class="entry-num">{{ '%02d' % e.number }}</span>
          <div class="entry-headline">
            <h3 class="entry-title">
              <a href="{{ e.read_original_url }}" target="_blank" rel="noopener">{{ e.title }}</a>
            </h3>
            <div class="entry-badges">
              <span class="badge badge-{{ e.band | band_class }}">{{ e.band }} · {{ e.relevance }}</span>
              {% for label in e.ring_labels %}
              <span class="badge badge-ring">{{ label }}</span>
              {% endfor %}
              {% if not e.ring_labels %}
              <span class="badge badge-none">no ring matched</span>
              {% endif %}
              {% if e.headline_only %}
              <span class="badge badge-headline" title="Source paywalled; assessed from the headline alone">headline only</span>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="source-block">
          <span class="source-label">Source</span>
          <span class="source-name">{{ e.source }}</span>
          <a class="source-read" href="{{ e.read_original_url }}" target="_blank" rel="noopener">Read the original &#8599;</a>
          <a class="source-url" href="{{ e.url }}" target="_blank" rel="noopener">{{ e.url }}</a>
          {% if e.date %}<span class="source-date">{{ e.date }}</span>{% endif %}
        </div>

        {% if e.annotation %}
        <p class="entry-annotation">{{ e.annotation }}</p>
        {% endif %}

        {% if e.notable_line %}
        <blockquote class="entry-quote">
          <span class="quote-label">{{ 'No quotation available' if e.headline_only else 'Notable line' }}</span>
          {% if e.headline_only %}
          <p>{{ e.notable_line }}</p>
          {% else %}
          <p>&ldquo;{{ e.notable_line }}&rdquo;</p>
          {% endif %}
        </blockquote>
        {% endif %}

        {% if e.tags %}
        <p class="entry-tags">{% for t in e.tags %}<span class="tag">{{ t }}</span>{% endfor %}</p>
        {% endif %}
      </li>
    {% endmacro %}

    {% if digest.entries %}
    {% set thr = digest.threshold or 40 %}
    {% set matched = digest.entries | selectattr("relevance", "ge", thr) | list %}
    {% set near = digest.entries | rejectattr("relevance", "ge", thr) | list %}

    <h3 class="subsection-head">Direct matches <span class="sec-count">&ge;{{ thr }} &middot; {{ matched|length }}</span></h3>
    {% if matched %}
    <ol class="entries">{% for e in matched %}{{ entry(e) }}{% endfor %}</ol>
    {% else %}
    <p class="none-note">No direct matches this run — no item reached the relevance threshold.</p>
    {% endif %}

    <h3 class="subsection-head">Watch-list near-matches <span class="sec-count">25&ndash;{{ thr - 1 }} &middot; {{ near|length }}</span></h3>
    {% if near %}
    <ol class="entries">{% for e in near %}{{ entry(e) }}{% endfor %}</ol>
    {% else %}
    <p class="none-note">No watch-list near-matches this run.</p>
    {% endif %}
    {% else %}
    <div class="no-developments" role="status">
      <p class="no-dev-head">No thematically relevant developments this cycle.</p>
      <p class="no-dev-sub">
        {{ digest.screened_str }} candidate{{ '' if digest.screened == 1 else 's' }} screened;
        none reached the relevance floor at the IP-as-investment / judicial-or-regulatory-measure /
        jurisdictional-admissibility intersection. A clean cycle is a finding, not a gap: the
        watcher ran and surfaced nothing worth your attention.
      </p>
    </div>
    {% endif %}

    {% if digest.per_source %}
    <h3 class="subsection-head">Source health <span class="sec-count">{{ digest.per_source|length }} feed{{ '' if digest.per_source|length == 1 else 's' }}</span></h3>
    <p class="run-note" style="margin-bottom:14px;">Which catalogue feeds were readable this run, with the count each yielded. A quiet or suppressed feed is shown, not hidden.</p>
    <table class="source-health" style="width:100%; border-collapse:collapse; font-family:var(--sans); font-size:14px;">
      <thead>
        <tr>
          <th style="text-align:left; font-size:11.5px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); border-bottom:1px solid var(--line); padding:6px 8px;">Source</th>
          <th style="text-align:left; font-size:11.5px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); border-bottom:1px solid var(--line); padding:6px 8px;">Status</th>
          <th style="text-align:right; font-size:11.5px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); border-bottom:1px solid var(--line); padding:6px 8px;">Items</th>
        </tr>
      </thead>
      <tbody>
        {% for name, count in digest.per_source.items() %}
        {% if name == "iareporter_headlines" %}{% set status = "HEADLINE-ONLY" %}{% set bcls = "badge-med" %}
        {% elif name == "google_news_rss" and count == 0 %}{% set status = "DISABLED" %}{% set bcls = "badge-low" %}
        {% else %}{% set status = "RETURNED" %}{% set bcls = "badge-high" %}{% endif %}
        <tr>
          <td style="padding:6px 8px; border-bottom:1px solid var(--line-soft);">{{ name | replace("_", " ") | title }}</td>
          <td style="padding:6px 8px; border-bottom:1px solid var(--line-soft);"><span class="badge {{ bcls }}">{{ status }}</span></td>
          <td style="padding:6px 8px; border-bottom:1px solid var(--line-soft); text-align:right; color:var(--muted);">{{ count }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
</section>
{% endblock %}

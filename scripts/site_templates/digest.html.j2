{% extends "base.html.j2" %}
{% block title %}{{ digest.title }} — ISDS Thematic Watcher{% endblock %}
{% block description %}Annotated digest of investor–State dispute developments surfaced on {{ digest.date }}, each with its source, a direct link to the original, a relevance score, and a quoted notable line.{% endblock %}

{% block content %}
<section class="page-head">
  <div class="measure">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ root }}index.html">Home</a></li>
        <li><a href="index.html">Digest Archive</a></li>
        <li aria-current="page">{{ digest.date }}</li>
      </ol>
    </nav>
    <h1 class="page-title">ISDS Thematic Watch</h1>
    <p class="page-date">{{ digest.date }}</p>
    <p class="page-lede">
      An annotated digest of investor–State dispute developments at the IP-as-investment /
      judicial-or-regulatory-measure / jurisdictional-admissibility intersection.
    </p>
    <div class="run-summary">
      <div class="run-stat"><span class="run-num">{{ digest.surfaced }}</span><span class="run-label">items surfaced</span></div>
      {% if digest.candidates %}<div class="run-stat"><span class="run-num">{{ digest.candidates }}</span><span class="run-label">candidates screened</span></div>{% endif %}
      {% if digest.threshold %}<div class="run-stat"><span class="run-num">{{ digest.threshold }}</span><span class="run-label">relevance threshold</span></div>{% endif %}
      {% if digest.classifier %}<div class="run-stat"><span class="run-num run-text">{{ digest.classifier }}</span><span class="run-label">classifier</span></div>{% endif %}
    </div>
    <p class="run-note">
      Entries are ordered by thematic relevance; each carries a two-sentence annotation and a
      notable line drawn from the source. Items below the gate are surfaced as watch-list leads,
      not matches.
    </p>
  </div>
</section>

<section class="band">
  <div class="measure">
    <h2 class="section-head">Annotated bibliography — {{ digest.surfaced }} {{ 'entry' if digest.surfaced == 1 else 'entries' }}</h2>

    {% if digest.entries %}
    <ol class="entries">
      {% for e in digest.entries %}
      <li class="entry" id="entry-{{ e.number }}">
        <div class="entry-top">
          <span class="entry-num">{{ '%02d' % e.number }}</span>
          <div class="entry-headline">
            <h3 class="entry-title">
              <a href="{{ e.read_original_url }}" target="_blank" rel="noopener">{{ e.title }}</a>
            </h3>
            <div class="entry-badges">
              <span class="badge badge-{{ e.band | band_class }}">{{ e.band }} · {{ e.relevance }}</span>
              {% for label in e.ring_labels %}
              <span class="badge badge-ring">{{ label }}</span>
              {% endfor %}
              {% if not e.ring_labels %}
              <span class="badge badge-none">no ring matched</span>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="source-block">
          <span class="source-label">Source</span>
          <span class="source-name">{{ e.source }}</span>
          <a class="source-read" href="{{ e.read_original_url }}" target="_blank" rel="noopener">Read the original &#8599;</a>
          <a class="source-url" href="{{ e.url }}" target="_blank" rel="noopener">{{ e.url }}</a>
          {% if e.date %}<span class="source-date">{{ e.date }}</span>{% endif %}
        </div>

        {% if e.annotation %}
        <p class="entry-annotation">{{ e.annotation }}</p>
        {% endif %}

        {% if e.notable_line %}
        <blockquote class="entry-quote">
          <span class="quote-label">Notable line</span>
          <p>&ldquo;{{ e.notable_line }}&rdquo;</p>
        </blockquote>
        {% endif %}

        {% if e.tags %}
        <p class="entry-tags">{% for t in e.tags %}<span class="tag">{{ t }}</span>{% endfor %}</p>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <p class="empty">This digest contains no entries.</p>
    {% endif %}
  </div>
</section>
{% endblock %}

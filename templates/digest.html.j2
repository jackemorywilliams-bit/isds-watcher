<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ISDS Thematic Watch — {{ date_str }}</title>
<style>
  body { font-family: Georgia, 'Times New Roman', serif; color: #1c2530;
         line-height: 1.55; margin: 0; padding: 0; background: #eef1f4; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 0 32px; background: #ffffff; }
  .head { background: #0b3d5c; color: #fff; padding: 26px 34px; }
  .head h1 { margin: 0 0 6px; font-size: 21px; letter-spacing: .2px; }
  .head .sub { font-size: 13px; opacity: .9; font-family: Arial, sans-serif; }
  .intro { padding: 18px 34px 4px; font-size: 14px; color: #33414f; }
  .section { padding: 6px 34px; }
  .secttl { font-family: Arial, sans-serif; font-size: 12px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .08em; color: #0b3d5c;
            border-bottom: 2px solid #0b3d5c; padding: 14px 0 5px; margin-top: 18px; }
  .entry { padding: 16px 0; border-bottom: 1px solid #e3e8ee; }
  .entry .num { font-weight: 700; color: #0b3d5c; }
  .cite { font-size: 15px; margin: 2px 0 6px; }
  .cite a { color: #0b3d5c; text-decoration: none; }
  .cite .src { font-variant: small-caps; color: #50606e; font-size: 13px;
               font-family: Arial, sans-serif; letter-spacing: .03em; }
  .badges { font-family: Arial, sans-serif; font-size: 11px; margin: 4px 0 8px; }
  .badges .score { background: #1a7f37; color: #fff; border-radius: 3px;
                   padding: 1px 7px; font-weight: 700; }
  .badges .score.med { background: #b8860b; }
  .badges .score.low { background: #6a7280; }
  .badges .ring { background: #0b3d5c; color: #fff; border-radius: 3px;
                  padding: 1px 7px; margin-left: 3px; }
  .annot { font-size: 14px; margin: 6px 0; color: #26323d; }
  .annot .lbl { font-family: Arial, sans-serif; font-size: 11px; font-weight: 700;
                text-transform: uppercase; letter-spacing: .05em; color: #50606e; }
  .quote { border-left: 3px solid #b8860b; background: #faf6ec; padding: 8px 12px;
           margin: 8px 0 4px; font-style: italic; font-size: 14px; color: #3a3322; }
  .tags { font-family: Arial, sans-serif; font-size: 11px; color: #6a7280; margin-top: 6px; }
  .empty { padding: 24px 34px; color: #50606e; }
  .footer { margin: 18px 34px 0; padding: 16px 0 0; border-top: 1px solid #e3e8ee;
            font-family: Arial, sans-serif; font-size: 12px; color: #6a7280; }
  .footer a { color: #0b5cae; }
  .footer table { border-collapse: collapse; }
  .footer td { padding: 1px 14px 1px 0; }
</style>
</head>
<body>
<div class="wrap">
  <div class="head">
    <h1>ISDS Thematic Watch — {{ date_str }}</h1>
    <div class="sub">An annotated digest of investor–state dispute developments at the
      IP-as-investment / judicial-or-regulatory-measure / jurisdictional-admissibility intersection.</div>
  </div>

  <div class="intro">
    <strong>{{ items|length }}</strong> item{{ "" if items|length == 1 else "s" }} surfaced
    for the window beginning {{ since.strftime("%d %B %Y") }}, screened from
    {{ stats.total_candidates }} candidates across {{ stats.per_source|length }} sources and
    scored by {{ stats.provider or "the keyword model" }}. Entries are ordered by thematic
    relevance; each carries a two-sentence annotation and a notable line drawn from the source.
  </div>

  {% macro entry(it, idx) %}
  {% set band = "score" if it.relevance_score >= 70 else ("score med" if it.relevance_score >= 40 else "score low") %}
  <div class="entry">
    <div class="cite"><span class="num">{{ idx }}.</span>
      <span class="src">{{ it.source|replace("_", " ") }}</span> —
      <a href="{{ it.url }}">{{ it.title }}</a>{% if it.published %},
      {{ it.published.strftime("%d %b %Y") }}{% endif %}.</div>
    <div class="badges"><span class="{{ band }}">relevance {{ it.relevance_score }}</span>{% for r in it.matched_rings %}<span class="ring">{{ r|replace("_"," ") }}</span>{% endfor %}</div>
    <div class="annot"><span class="lbl">Annotation.</span> {{ it.digest_summary }}</div>
    {% if it.metadata.get("notable_quote") %}<div class="quote">“{{ it.metadata.get("notable_quote") }}”</div>{% endif %}
    {% if it.thematic_tags %}<div class="tags">Tags: {{ it.thematic_tags|reject("equalto","keyword_fallback")|join(" · ") }}</div>{% endif %}
  </div>
  {% endmacro %}

  {% if not items %}
    <div class="empty">No items met the relevance floor this cycle. Sources screened:
      {% for s, n in stats.per_source.items() %}{{ s }} ({{ n }}){{ ", " if not loop.last }}{% endfor %}.</div>
  {% else %}
    <div class="section">
      <div class="secttl">Annotated bibliography — {{ items|length }} entr{{ "y" if items|length == 1 else "ies" }}</div>
      {% for it in items %}{{ entry(it, loop.index) }}{% endfor %}
    </div>
  {% endif %}

  <div class="footer">
    <p><strong>Theme.</strong> {{ theme }}</p>
    <table>
      <tr><td>Generated</td><td>{{ generated_at.strftime("%Y-%m-%d %H:%M UTC") }}</td></tr>
      <tr><td>Candidates screened</td><td>{{ stats.total_candidates }}</td></tr>
      <tr><td>At/above threshold ({{ stats.threshold }})</td><td>{{ stats.above_threshold }}</td></tr>
      <tr><td>Surfaced in this digest</td><td>{{ items|length }}</td></tr>
      <tr><td>Classifier</td><td>{{ stats.provider or "keyword-fallback" }}</td></tr>
    </table>
    <p>Per source: {% for s, n in stats.per_source.items() %}{{ s }}={{ n }}{{ ", " if not loop.last }}{% endfor %}{% if stats.dropped_sources %} · dropped/empty: {{ stats.dropped_sources|join(", ") }}{% endif %}</p>
    {% if folder_url %}<p>Full archive for this date (one file per surfaced article): <a href="{{ folder_url }}">{{ folder_url }}</a></p>{% endif %}
    <p>Methodology: <a href="{{ repo_url }}/blob/main/METHODOLOGY.md">METHODOLOGY.md</a> · Repository: <a href="{{ repo_url }}">{{ repo_url }}</a></p>
  </div>
</div>
</body>
</html>
